<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/light_gray">

    <!-- Кнопка назад -->
    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Назад"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_marginBottom="16dp" />

    <!-- Аватар -->
    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_avatar"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <!-- Статус -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🟢 Онлайн"
        android:textSize="16sp"
        android:textColor="@android:color/black"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp" />

    <!-- Блок Base32 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ваш I2P адрес (Base32)"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="@android:color/black"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvMyAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Загрузка..."
        android:textSize="14sp"
        android:textColor="@android:color/black"
        android:padding="8dp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="16dp" />

    <!-- Кнопки -->
    <Button
        android:id="@+id/btnCopyAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📋 Копировать адрес"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnShareAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📤 Поделиться адресом"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_marginBottom="24dp" />

    <!-- Блок Base64 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Полный ключ (Base64)"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="@android:color/black"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvMyBase64"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Скрыто"
        android:textSize="12sp"
        android:textColor="@android:color/black"
        android:padding="8dp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="16dp" />

</LinearLayout>